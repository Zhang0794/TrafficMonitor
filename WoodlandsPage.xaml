<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TrafficMonitor.WoodlandsPage"
             BackgroundColor="{AppThemeBinding Light=#F3F6FB, Dark=#111827}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Header -->
            <Frame CornerRadius="24" Padding="20" BackgroundColor="#2563EB" HasShadow="True">
                <VerticalStackLayout Spacing="6">
                    <Label Text="📍 Woodlands Checkpoint"
                           FontSize="30"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"/>
                    <Label Text="Smart Causeway Traffic Monitoring"
                           FontSize="14"
                           TextColor="#DBEAFE"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Live Camera -->
            <Frame CornerRadius="20" Padding="0" HasShadow="True">
                <Grid>
                    <Image Source="traffic.jpg"
                           HeightRequest="230"
                           Aspect="AspectFill"/>
                    <Frame BackgroundColor="#80000000"
                           CornerRadius="12"
                           Padding="8"
                           Margin="12"
                           HorizontalOptions="Start"
                           VerticalOptions="Start">
                        <Label Text="🔴 LIVE"
                               TextColor="White"
                               FontAttributes="Bold"/>
                    </Frame>
                </Grid>
            </Frame>

            <!-- Main Status -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                <Frame CornerRadius="18" BackgroundColor="White" Padding="18" HasShadow="True">
                    <VerticalStackLayout>
                        <Label Text="Traffic Status" FontSize="14" TextColor="#6B7280"/>
                        <Label x:Name="TrafficStatusLabel"
                               Text="Moderate"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="#F59E0B"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame Grid.Column="1" CornerRadius="18" BackgroundColor="White" Padding="18" HasShadow="True">
                    <VerticalStackLayout>
                        <Label Text="Wait Time" FontSize="14" TextColor="#6B7280"/>
                        <Label x:Name="WaitTimeLabel"
                               Text="18 mins"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="#DC2626"/>
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <!-- Vehicle Breakdown -->
            <Frame CornerRadius="20" Padding="20" BackgroundColor="White" HasShadow="True">
                <VerticalStackLayout Spacing="12">
                    <Label Text="🚗 Vehicle Breakdown"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#111827"/>
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="10">
                        <Label Text="Cars: 26" FontSize="16"/>
                        <Label Grid.Column="1" Text="Trucks: 6" FontSize="16"/>
                        <Label Grid.Row="1" Text="Buses: 2" FontSize="16"/>
                        <Label Grid.Row="1" Grid.Column="1" Text="Motorcycles: 9" FontSize="16"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Smart Advice -->
            <Frame CornerRadius="18" Padding="16" BackgroundColor="#FEF3C7" BorderColor="#FCD34D">
                <Label x:Name="SmartAdviceLabel"
                       Text="⚠ Consider Tuas if peak hour traffic increases"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="#B45309"/>
            </Frame>

            <!-- Analytics -->
            <Frame CornerRadius="20" Padding="20" BackgroundColor="White" HasShadow="True">
                <VerticalStackLayout Spacing="14">
                    <Label Text="📊 Causeway Traffic Flow"
                           FontSize="20"
                           FontAttributes="Bold"/>
                    <ProgressBar x:Name="TrafficFlowBar" Progress="0.65" HeightRequest="10"/>
                    <Label x:Name="PeakHourLabel"
                           Text="Peak Hour: 7:00 - 9:00 AM"
                           FontSize="14"
                           TextColor="#6B7280"/>
                    <Label x:Name="LastUpdatedLabel"
                           Text="Last Updated: 10:30 AM"
                           FontSize="14"
                           TextColor="#6B7280"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Actions -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Text="🔄 Refresh"
                        BackgroundColor="#22C55E"
                        TextColor="White"
                        HeightRequest="55"
                        CornerRadius="14"
                        Clicked="Refresh_Clicked"/>

                <Button Grid.Column="1"
                        Text="🧠 Smart Advice"
                        BackgroundColor="#F59E0B"
                        TextColor="White"
                        HeightRequest="55"
                        CornerRadius="14"
                        Clicked="Advice_Clicked"/>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
