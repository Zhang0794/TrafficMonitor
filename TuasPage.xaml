<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TrafficMonitor.TuasPage"
             BackgroundColor="{AppThemeBinding Light=#F3F6FB, Dark=#111827}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Header -->
            <Frame CornerRadius="24" Padding="20" BackgroundColor="#1D4ED8" HasShadow="True">
                <VerticalStackLayout Spacing="6">
                    <Label Text="📍 Tuas Checkpoint"
                           FontSize="30"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"/>
                    <Label Text="Live Border Traffic Monitoring"
                           FontSize="14"
                           TextColor="#DBEAFE"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Live Camera -->
            <Frame CornerRadius="20" Padding="0" HasShadow="True">
                <Grid>
                    <Image Source="traffic.jpg"
                           HeightRequest="230"
                           Aspect="AspectFill"/>
                    <Frame BackgroundColor="#80000000"
                           CornerRadius="12"
                           Padding="8"
                           Margin="12"
                           HorizontalOptions="Start"
                           VerticalOptions="Start">
                        <Label Text="🔴 LIVE"
                               TextColor="White"
                               FontAttributes="Bold"/>
                    </Frame>
                </Grid>
            </Frame>

            <!-- Status Cards -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                <Frame CornerRadius="18" BackgroundColor="White" Padding="18" HasShadow="True">
                    <VerticalStackLayout>
                        <Label Text="Traffic Status" FontSize="14" TextColor="#6B7280"/>
                        <Label x:Name="TrafficStatusLabel"
                               Text="Smooth"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="#16A34A"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame Grid.Column="1" CornerRadius="18" BackgroundColor="White" Padding="18" HasShadow="True">
                    <VerticalStackLayout>
                        <Label Text="Wait Time" FontSize="14" TextColor="#6B7280"/>
                        <Label x:Name="WaitTimeLabel"
                               Text="8 mins"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="#DC2626"/>
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <!-- Vehicle Stats -->
            <Frame CornerRadius="20" Padding="20" BackgroundColor="White" HasShadow="True">
                <VerticalStackLayout Spacing="12">
                    <Label Text="🚗 Vehicle Breakdown"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#111827"/>
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="10">
                        <Label Text="Cars: 12" FontSize="16"/>
                        <Label Grid.Column="1" Text="Trucks: 3" FontSize="16"/>
                        <Label Grid.Row="1" Text="Buses: 1" FontSize="16"/>
                        <Label Grid.Row="1" Grid.Column="1" Text="Motorcycles: 5" FontSize="16"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Alert + Recommendation -->
            <Frame CornerRadius="18" Padding="16" BackgroundColor="#ECFDF5" BorderColor="#86EFAC">
                <Label x:Name="SmartAdviceLabel"
                       Text="✅ Best route currently: Tuas checkpoint"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="#15803D"/>
            </Frame>

            <!-- Analytics -->
            <Frame CornerRadius="20" Padding="20" BackgroundColor="White" HasShadow="True">
                <VerticalStackLayout Spacing="14">
                    <Label Text="📊 Traffic Flow"
                           FontSize="20"
                           FontAttributes="Bold"/>
                    <ProgressBar x:Name="TrafficFlowBar" Progress="0.30" HeightRequest="10"/>
                    <Label x:Name="LastUpdatedLabel"
                           Text="Last Updated: 10:30 AM"
                           FontSize="14"
                           TextColor="#6B7280"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Action Buttons -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Text="🔄 Refresh"
                        BackgroundColor="#22C55E"
                        TextColor="White"
                        HeightRequest="55"
                        CornerRadius="14"
                        Clicked="Refresh_Clicked"/>

                <Button Grid.Column="1"
                        Text="🗺 Route Advice"
                        BackgroundColor="#F59E0B"
                        TextColor="White"
                        HeightRequest="55"
                        CornerRadius="14"
                        Clicked="Advice_Clicked"/>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
