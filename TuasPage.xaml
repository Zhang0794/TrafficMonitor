<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TrafficMonitor.TuasPage">

    <VerticalStackLayout Padding="30" Spacing="20">

        <Label
            Text="📍 Tuas Checkpoint"
            FontSize="28"
            FontAttributes="Bold"/>

        <Image
            Source="traffic.jpg"
            HeightRequest="200"
            Aspect="AspectFill"/>

        <Label
            Text="Current Traffic Status: Smooth"
            FontSize="18"/>

    </VerticalStackLayout>

</ContentPage>