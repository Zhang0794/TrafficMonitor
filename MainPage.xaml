<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TrafficMonitor.MainPage"
             BackgroundColor="#F3F6FB">

    <Grid RowDefinitions="*,Auto">

        <!-- 🔹 主内容区域 -->
        <ContentView x:Name="MainContent"
                     Grid.Row="0"
                     Padding="10"/>

        <!-- 🔹 底部导航栏 -->
        <Frame Grid.Row="1"
               BackgroundColor="White"
               Padding="10"
               Margin="15"
               CornerRadius="25"
               HasShadow="True">

            <Grid ColumnDefinitions="*,*,*">

                <!-- Home -->
                <Button Text="🏠&#10;Home"
                        Clicked="Home_Clicked"
                        BackgroundColor="Transparent"
                        FontSize="14"/>

                <!-- Analytics -->
                <Button Text="📊&#10;Analytics"
                        Grid.Column="1"
                        Clicked="Analytics_Clicked"
                        BackgroundColor="Transparent"
                        FontSize="14"/>

                <!-- User -->
                <Button Text="👤&#10;User"
                        Grid.Column="2"
                        Clicked="User_Clicked"
                        BackgroundColor="Transparent"
                        FontSize="14"/>

            </Grid>
        </Frame>

    </Grid>

</ContentPage>