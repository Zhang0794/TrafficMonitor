<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TrafficMonitor.MainPage"
             BackgroundColor="#F3F6FB">

    <Grid RowDefinitions="*,Auto">

        <!-- 页面内容 -->
        <ContentView x:Name="MainContent" Grid.Row="0"/>

        <!-- 底部导航栏 -->
        <Grid Grid.Row="1"
              BackgroundColor="White"
              Padding="10"
              ColumnDefinitions="*,*,*"
              HeightRequest="70">

            <Button x:Name="HomeBtn"
                    Text="🏠\n首页"
                    Clicked="Home_Clicked"
                    BackgroundColor="Transparent"/>

            <Button x:Name="AnalyticsBtn"
                    Grid.Column="1"
                    Text="📊\n分析"
                    Clicked="Analytics_Clicked"
                    BackgroundColor="Transparent"/>

            <Button x:Name="UserBtn"
                    Grid.Column="2"
                    Text="👤\n我的"
                    Clicked="User_Clicked"
                    BackgroundColor="Transparent"/>

        </Grid>
    </Grid>
</ContentPage>