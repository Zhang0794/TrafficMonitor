<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TrafficMonitor.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:TrafficMonitor"
    Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent
            Title="Home"
            Icon="home.png"
            ContentTemplate="{DataTemplate local:MainPage}" />

        <ShellContent
            Title="Woodlands"
            Icon="woodlands.png"
            ContentTemplate="{DataTemplate local:WoodlandsPage}" />

        <ShellContent
            Title="Tuas"
            Icon="tuas.png"
            ContentTemplate="{DataTemplate local:TuasPage}" />
    </TabBar>
</Shell>